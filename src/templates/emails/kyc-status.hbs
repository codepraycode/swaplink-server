{{#if isSubmitted}}
    <p>We have received your KYC documents. Our compliance team is currently reviewing them.</p>
    <p>This process usually takes 24-48 hours. We will notify you once the review is complete.</p>
{{/if}}

{{#if isSuccess}}
    <p style='color: #27ae60; font-weight: bold; font-size: 18px;'>Congratulations! 🎉</p>
    <p>Your identity has been verified successfully. Your account limits have been upgraded.</p>

    {{#if account_number}}
        <div
            style='background-color: #f9f9f9; padding: 15px; border-radius: 5px; margin: 20px 0; border: 1px solid #eeeeee;'
        >
            <p style='margin-top: 0; margin-bottom: 10px; font-weight: bold; color: #4b0082;'>Your
                Wallet Details:</p>
            <p style='margin: 5px 0;'><strong>Bank Name:</strong> {{bank_name}}</p>
            <p style='margin: 5px 0;'><strong>Account Number:</strong> {{account_number}}</p>
            <p style='margin: 5px 0;'><strong>Account Name:</strong> {{account_name}}</p>
        </div>
    {{/if}}

    <a href='{{dashboard_url}}' class='btn' style='color: #fff;'>Go to Dashboard</a>
{{/if}}

{{#if isFailed}}
    <p style='color: #c0392b; font-weight: bold; font-size: 18px;'>Action Required ⚠️</p>
    <p>Unfortunately, we could not verify your identity based on the documents provided.</p>
    <p><strong>Reason:</strong> {{reason}}</p>
    <p>Please log in and re-upload a clear copy of your document.</p>
    <a href='{{kyc_url}}' class='btn' style='color: #fff;'>Retry KYC</a>
{{/if}}